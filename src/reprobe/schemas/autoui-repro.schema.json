{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoui.org/schemas/autoui-repro.schema.json",
  "title": "autoui-repro manifest",
  "description": "Optional author manifest that removes guesswork from reprobe. All fields optional except version.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builder": { "enum": ["pinned-base", "repo2docker", "author-image"] },
        "type": { "enum": ["python", "r", "jupyter", "unity", "custom"] },
        "dependencies": { "type": ["string", "null"], "description": "requirements.txt | environment.yml | renv.lock" },
        "r_packages": { "type": "array", "items": { "type": "string" }, "description": "CRAN package names to install into the sandbox (the CRAN-available subset is installed in the sanctioned egress phase)" },
        "image": { "type": ["string", "null"], "description": "optional pinned image digest to use as-is" }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "description": "The paper whose claims this artifact reproduces. Used for an ADVISORY claim-by-claim comparison against what the re-run produces; it never grants a badge.",
      "properties": {
        "doi": { "type": "string", "description": "DOI of the paper, e.g. 10.1145/3613904.3641909" },
        "pdf": { "type": "string", "description": "path to a PDF of the paper committed in this repository (preferred: full text, no network)" }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "source": { "type": "string", "description": "DOI or URL the data is fetched from" },
          "checksum": { "type": "string" }
        }
      }
    },
    "data_sources": {
      "type": "array",
      "description": "External data deposits merged into the artifact tree before the run — for the common 'code in git, data on OSF' split. Each is fetched with the same fetchers as a submission (OSF, Zenodo, Dryad, figshare, Dataverse, git, or a direct http(s) URL).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": { "type": "string", "description": "URL or DOI of the deposit" },
          "into": { "type": "string", "description": "subdirectory to merge it into (default: artifact root)" }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "description": "a file path to execute" },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string" },
                  "kind": { "enum": ["python", "r", "jupyter", "rmarkdown", "custom"] },
                  "runner": { "type": "string" },
                  "args": { "type": "array", "items": { "type": "string" }, "description": "command-line arguments passed to the script" },
                  "tool": { "type": "string", "description": "e.g. unity" },
                  "project": { "type": "string" },
                  "tier": { "enum": ["structural", "compile", "build"] },
                  "expected_outputs": { "type": "array", "items": { "type": "string" } },
                  "description": { "type": "string" }
                }
              }
            ]
          }
        },
        "network": { "type": "boolean", "default": false }
      }
    },
    "expected_outputs": { "type": "array", "items": { "type": "string" } },
    "badges_claimed": {
      "type": "array",
      "items": { "enum": ["available", "functional", "reusable", "reproduced"] }
    }
  }
}
